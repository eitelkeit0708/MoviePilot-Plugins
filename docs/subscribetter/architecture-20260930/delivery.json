  "cards": [
    {
      "dot": "cyan",
      "title": "本地字节和资产",
      "items": [
        "Organizer 核验下载完成、文件选择、源大小与完整 Hash，再调用宿主公共 TransferChain 并核对回执。",
        "Delivery.prepare 要求原计划、规则、完整整理回执、稳定窗口与全部资产清单；扫描或 watcher 只是发现提示。",
        "读源拒绝越界、符号链接及身份替换；字幕经历独立稳定观察，未知结果保持等待。"
      ]
    },
    {
      "dot": "amber",
      "title": "秒传与普通上传",
      "items": [
        "秒传 HIT 后独立读回；只有有效 MISS 消耗预算，达到配置阈值且文件大小允许时才 CD2 回退。",
        "CD2 先订阅通道再 Start，持久化 upload ID 后按原请求泵送字节；响应超时保留 UNKNOWN。",
        "主动父目录刷新与云文件大小、Hash 核验完成前，不进入可发布状态。"
      ]
    },
    {
      "dot": "rose",
      "title": "发布屏障与恢复",
      "items": [
        "PublicationGate 重核验身份、准入、范围、排除、当前质量、资产完整及远端内容；Authority 持久化发布屏障。",
        "目录 move 响应未知保持 PUBLISH_OUTCOME_UNKNOWN；目录存在或相同大小不能单独证明成功。",
        "恢复沿原外部 ID 对账，不因时间到期重发或解锁；取消、监控清理、暂存清理、下载器任务和源数据权限独立。"
      ]
    },
    {
      "dot": "emerald",
      "title": "消费者与档案",
      "items": [
        "Symedia 是外部目录消费者，插件不声称自动补处理已发生；缺失消费能力呈现 WAIT_CONSUMER。",
        "observe_consumer 有界读取选定 Emby 条目、实际 STRM、云目录内容与附件，生成精确 settled 回执。",
        "Archive 在激活前再次独立核验身份、Hash、当前质量、代次、排除与修订，事务更新入库回执和 PRESENT 版本。"
      ]
    }
  ]
}